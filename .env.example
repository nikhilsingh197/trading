# ─────────────────────────────────────────────────────────────────────────────
# AI Crypto Trader — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | paper | live
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_32_CHARS

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:CHANGE_ME@localhost:5432/crypto_trader
DATABASE_SYNC_URL=postgresql+psycopg2://trader:CHANGE_ME@localhost:5432/crypto_trader
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Exchange ──────────────────────────────────────────────────────────────────
# WARNING: Use testnet keys during development.
# Disable withdrawal permissions on API keys.
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=YOUR_TESTNET_API_KEY
EXCHANGE_API_SECRET=YOUR_TESTNET_API_SECRET
EXCHANGE_SANDBOX=true        # true = testnet/sandbox, false = live

# ── Trading Mode ─────────────────────────────────────────────────────────────
# paper  → simulated trading only (default, safe)
# shadow → paper runs alongside a live champion
# live   → real money (requires LIVE_TRADING_ENABLED=true + human confirmation)
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false   # Must be explicitly set to true by a human

# ── Risk Limits (hard limits — human-controlled) ──────────────────────────────
RISK_MAX_TRADE_RISK_PCT=0.50        # Max % of account per trade
RISK_DAILY_LOSS_LIMIT_PCT=2.0       # Max daily loss before halting
RISK_MAX_DRAWDOWN_HALT_PCT=10.0     # Max drawdown before kill switch
RISK_MAX_DRAWDOWN_REDUCE_PCT=5.0    # Drawdown at which size is halved
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_LEVERAGE=3
RISK_MAX_POSITION_SIZE_PCT=10.0     # Max % of account in single position
RISK_MAX_CORRELATED_EXPOSURE_PCT=20.0
RISK_MAX_TRADES_PER_DAY=20
RISK_MAX_CONSECUTIVE_LOSSES=6

# ── Paper Trading Validation ──────────────────────────────────────────────────
PAPER_MIN_PERIOD_DAYS=30
PAPER_MIN_TRADES=100

# ── Strategy Scorecard Thresholds ─────────────────────────────────────────────
SCORECARD_MIN_SHARPE=0.5
SCORECARD_MIN_PROFIT_FACTOR=1.2
SCORECARD_MAX_DRAWDOWN_PCT=15.0
SCORECARD_MIN_WIN_RATE=0.40
SCORECARD_MIN_TRADES=50
SCORECARD_MIN_EXPECTANCY=0.0

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2
API_RELOAD=true              # Set to false in production

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ── Alerts ────────────────────────────────────────────────────────────────────
ALERT_TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ALERT_TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=your_email@gmail.com
ALERT_EMAIL_PASSWORD=YOUR_APP_PASSWORD
ALERT_EMAIL_TO=alerts@yourdomain.com

# ── Data ──────────────────────────────────────────────────────────────────────
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_LIVE_DIR=./data/live
MODEL_ARTIFACT_DIR=./data/models
REPORT_OUTPUT_DIR=./data/reports

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
ENABLE_METRICS=true

# ── Drift Detection ───────────────────────────────────────────────────────────
DRIFT_KS_PVALUE_THRESHOLD=0.05
DRIFT_WIN_RATE_DECLINE_PCT=20.0
DRIFT_CONFIDENCE_DECLINE_PCT=15.0
